# ── App (.env.local on the server, chmod 600) ────────────────────────────────
# The login password, either in plain text (simple) or as a hash (if both are set, the hash wins).
# Hash: `printf 'your-password\n' | node scripts/hash-password.mjs`
UI_PASSWORD=
UI_PASSWORD_HASH=
# 32+ random characters, signs the session cookie: `openssl rand -base64 48`
UI_SECRET=replace-me-with-at-least-32-random-characters
# Host names the app and the terminal backend answer (blocks DNS rebinding). Loopback names (127.0.0.1, localhost,
# [::1]) always work. PUBLIC_HOSTNAME (scripts/setup.sh writes it from .env.deploy) is allowed too; add any other name
# you reach agent-u by (a Tailscale name, a LAN proxy) as a comma list, host or host:port. With neither set, any Host
# is accepted and a warning is logged.
ALLOWED_HOSTS=
# PUBLIC_HOSTNAME=claude.example.com
# Set to 1 only when every request comes through the Cloudflare tunnel (scripts/setup.sh does when one is configured):
# the login rate limit then tells clients apart by cf-connecting-ip. Unset, all clients share one limit.
TRUST_PROXY_HEADERS=
# Optional: the claude binary the Agent SDK drives (defaults to the SDK's bundled CLI)
CLAUDE_BIN=
# Optional: where Claude Code keeps its data (default ~/.claude)
CLAUDE_HOME=
# Optional: project folders (substring match) hidden from the session list
HIDE_PROJECTS=claude-mem-observer
# Optional: web runs with no viewers stop after this many ms idle (default 20 min)
IDLE_REAP_MS=1200000
# Optional: port of the web terminal backend (server/pty.mjs)
PTY_PORT=3312
# Optional: other agents' binaries (default: found on PATH)
CODEX_BIN=
OPENCODE_BIN=
CURSOR_AGENT_BIN=
DEVIN_BIN=
KIMI_BIN=
GEMINI_BIN=
AGY_BIN=
# Optional: other agents' data (defaults ~/.codex, ~/.local/share/opencode/opencode.db, ~/.cursor, ~/.kimi-code,
# and for Gemini CLI the home that holds .gemini, default ~; Antigravity always reads ~/.gemini/antigravity-cli)
CODEX_HOME=
OPENCODE_DB=
CURSOR_CONFIG_DIR=
KIMI_CODE_HOME=
GEMINI_CLI_HOME=
# Gemini CLI needs an API key (or Vertex AI / Code Assist settings); Google account sign-in moved to Antigravity
# GEMINI_API_KEY=
# Optional: folder for agent-u's own config.json (profiles) and state.json (default ~/.config/agent-u)
AGENT_U_HOME=
# Optional: the profiles file itself, if it lives elsewhere (default $AGENT_U_HOME/config.json)
AGENT_U_CONFIG=
# Optional: plain shells nobody looked at for this long are closed (default 12 h); agents are kept
SHELL_IDLE_MS=
# Optional: checkpoint limits, so they don't fill the repository's .git. Untracked files larger than this are left
# out of a checkpoint (default 20)
CHECKPOINT_MAX_FILE_MB=
# Optional: skip a checkpoint when the untracked files it would add come to more than this (default 200)
CHECKPOINT_MAX_TOTAL_MB=
# Optional: checkpoints older than this are deleted (default 30)
CHECKPOINT_MAX_AGE_DAYS=
# Secrets that profiles read with ${NAME} in their env, e.g. a proxy key
# PROXY_KEY=
# Optional: set to exec to drive Codex turns with `codex exec --json` instead of `codex app-server`
CODEX_WEB_DRIVER=

# ── Deploy (.env.deploy on your machine, read by scripts/deploy.sh) ─────────
# SSH target and port of the server
DEPLOY_SSH=user@your-server
DEPLOY_SSH_PORT=22
# App folder on the server, relative to the remote user's home (no ~: it would expand locally)
DEPLOY_DIR=agent-u
# Public hostname routed to the app by a Cloudflare named tunnel
PUBLIC_HOSTNAME=claude.example.com
# Cloudflare tunnel name (created with `cloudflared tunnel create <name>`)
TUNNEL_NAME=agent-u
