{
  "name": "agent-u",
  "short_name": "agent-u",
  "description": "Your coding agents, from any screen.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#17181a",
  "theme_color": "#17181a",
  "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }],
  "shortcuts": [
    { "name": "New session", "short_name": "New", "url": "/?s=new", "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "Inbox", "url": "/?s=@inbox", "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }] }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "files", "accept": ["*/*"] }] }
  }
}
